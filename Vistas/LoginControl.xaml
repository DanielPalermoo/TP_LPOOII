<UserControl x:Class="Vistas.LoginControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="320">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Mueblería - Inicio de Sesión" Foreground="Black" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,0,0,20" FontFamily="Segoe UI"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Usuario" Foreground="Black" FontSize="12" Margin="0,0,0,4" FontFamily="Segoe UI"/>
            <TextBox x:Name="txtUsuario" Style="{StaticResource Win10TextBox}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Contraseña" Foreground="Black" FontSize="12" Margin="0,0,0,4" FontFamily="Segoe UI"/>
            <PasswordBox x:Name="txtContrasenia" Style="{StaticResource Win10PasswordBox}"/>
        </StackPanel>

        <Button Grid.Row="3" x:Name="btnIngresar" Content="Ingresar" Height="30" Click="btnIngresar_Click" Style="{StaticResource Win10AccentButton}" IsDefault="True"/>
    </Grid>
</UserControl>
