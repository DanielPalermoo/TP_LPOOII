                <Setter TargetName="border" Property="Background" Value="#E1F3E8"/>
                <Setter TargetName="border" Property="BorderBrush" Value="#107C41"/>
                <Setter Property="Foreground" Value="#0B5A2D"/>
                <Setter Property="FontSize" Value="14"/>
