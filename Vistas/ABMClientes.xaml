<Window x:Class="Vistas.ABMClientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Clientes" Height="350" Width="680"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F3F3">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,15">
            <Button x:Name="btnNuevo" Content="Nuevo" Width="70" Height="28" Margin="0,0,5,0" Style="{StaticResource RedButton}" Click="btnNuevo_Click"/>
            <Button x:Name="btnModificar" Content="Modificar" Width="70" Height="28" Margin="0,0,5,0" Style="{StaticResource RedButton}"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="70" Height="28" Margin="0,0,15,0" Style="{StaticResource RedButton}"/>

            <Button x:Name="btnGuardar" Content="Guardar" Width="70" Height="28" Margin="0,0,5,0" Style="{StaticResource BlueButton}" IsEnabled="False" Click="btnGuardar_Click"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="70" Height="28" Margin="0,0,15,0" Style="{StaticResource BlueButton}" IsEnabled="False" Click="btnCancelar_Click"/>

            <Button x:Name="btnPrimero" Content="Primero" Width="55" Height="28" Margin="0,0,3,0" Style="{StaticResource GreenButton}"/>
            <Button x:Name="btnAnterior" Content="Anterior" Width="55" Height="28" Margin="0,0,3,0" Style="{StaticResource GreenButton}"/>
            <Button x:Name="btnSiguiente" Content="Siguiente" Width="55" Height="28" Margin="0,0,3,0" Style="{StaticResource GreenButton}"/>
            <Button x:Name="btnUltimo" Content="Último" Width="55" Height="28" Style="{StaticResource GreenButton}"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" Text="Gestión de Clientes" Foreground="Black" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" FontFamily="Segoe UI"/>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="DNI:" VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI" Margin="0,0,0,8"/>
            <TextBox x:Name="txtDni" Grid.Column="1" Style="{StaticResource Win10TextBox}" IsEnabled="False" Margin="0,0,0,8"/>

            <TextBlock Text="Apellido:" Grid.Row="1" VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI" Margin="0,0,0,8"/>
            <TextBox x:Name="txtApellido" Grid.Row="1" Grid.Column="1" Style="{StaticResource Win10TextBox}" IsEnabled="False" Margin="0,0,0,8"/>

            <TextBlock Text="Nombre:" Grid.Row="2" VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI" Margin="0,0,0,8"/>
            <TextBox x:Name="txtNombre" Grid.Row="2" Grid.Column="1" Style="{StaticResource Win10TextBox}" IsEnabled="False" Margin="0,0,0,8"/>

            <TextBlock Text="Dirección:" Grid.Row="3" VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI" Margin="0,0,0,8"/>
            <TextBox x:Name="txtDireccion" Grid.Row="3" Grid.Column="1" Style="{StaticResource Win10TextBox}" IsEnabled="False" Margin="0,0,0,8"/>
        </Grid>

        <Button Grid.Row="3" x:Name="btnSalir" Content="Salir" Width="80" Height="28" HorizontalAlignment="Right" Style="{StaticResource BlueButton}" Click="btnSalir_Click"/>
    </Grid>
</Window>
