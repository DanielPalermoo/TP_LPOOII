<Window x:Class="Vistas.ABMProductos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Productos" Height="370" Width="680"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F3F3">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Estilos.xaml"/>
                <ResourceDictionary Source="Plantillas.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,15">
            <Button x:Name="btnNuevo" Content="Nuevo" Width="70" Height="28" Margin="0,0,5,0" Background="#E1E1E1" Foreground="#E81123" BorderBrush="#7A7A7A" BorderThickness="1" Cursor="Hand" Template="{StaticResource PlantillaBotonRojo}" Click="btnNuevo_Click"/>
            <Button x:Name="btnModificar" Content="Modificar" Width="70" Height="28" Margin="0,0,5,0" Background="#E1E1E1" Foreground="#E81123" BorderBrush="#7A7A7A" BorderThickness="1" Cursor="Hand" Template="{StaticResource PlantillaBotonRojo}"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="70" Height="28" Margin="0,0,15,0" Background="#E1E1E1" Foreground="#E81123" BorderBrush="#7A7A7A" BorderThickness="1" Cursor="Hand" Template="{StaticResource PlantillaBotonRojo}"/>

            <Button x:Name="btnGuardar" Content="Guardar" Width="70" Height="28" Margin="0,0,5,0" Background="#E1E1E1" Foreground="#0078D7" BorderBrush="#7A7A7A" BorderThickness="1" Cursor="Hand" Template="{StaticResource PlantillaBotonAzul}" IsEnabled="False" Click="btnGuardar_Click"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="70" Height="28" Margin="0,0,15,0" Background="#E1E1E1" Foreground="#0078D7" BorderBrush="#7A7A7A" BorderThickness="1" Cursor="Hand" Template="{StaticResource PlantillaBotonAzul}" IsEnabled="False" Click="btnCancelar_Click"/>

            <Button x:Name="btnPrimero" Content="Primero" Width="55" Height="28" Margin="0,0,3,0" Background="#E1E1E1" Foreground="#107C41" BorderBrush="#7A7A7A" BorderThickness="1" Cursor="Hand" Template="{StaticResource PlantillaBotonVerde}"/>
            <Button x:Name="btnAnterior" Content="Anterior" Width="55" Height="28" Margin="0,0,3,0" Background="#E1E1E1" Foreground="#107C41" BorderBrush="#7A7A7A" BorderThickness="1" Cursor="Hand" Template="{StaticResource PlantillaBotonVerde}"/>
            <Button x:Name="btnSiguiente" Content="Siguiente" Width="55" Height="28" Margin="0,0,3,0" Background="#E1E1E1" Foreground="#107C41" BorderBrush="#7A7A7A" BorderThickness="1" Cursor="Hand" Template="{StaticResource PlantillaBotonVerde}"/>
            <Button x:Name="btnUltimo" Content="Último" Width="55" Height="28" Background="#E1E1E1" Foreground="#107C41" BorderBrush="#7A7A7A" BorderThickness="1" Cursor="Hand" Template="{StaticResource PlantillaBotonVerde}"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" Text="Gestión de Productos" Foreground="Black" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" FontFamily="Segoe UI"/>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Código Producto:" VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI" Margin="0,0,0,8"/>
            <TextBox x:Name="txtCodProducto" Grid.Column="1" Style="{StaticResource Win10TextBox}" IsEnabled="False" Margin="0,0,0,8"/>

            <TextBlock Text="Categoría:" Grid.Row="1" VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI" Margin="0,0,0,8"/>
            <TextBox x:Name="txtCategoria" Grid.Row="1" Grid.Column="1" Style="{StaticResource Win10TextBox}" IsEnabled="False" Margin="0,0,0,8"/>

            <TextBlock Text="Color:" Grid.Row="2" VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI" Margin="0,0,0,8"/>
            <TextBox x:Name="txtColor" Grid.Row="2" Grid.Column="1" Style="{StaticResource Win10TextBox}" IsEnabled="False" Margin="0,0,0,8"/>

            <TextBlock Text="Descripción:" Grid.Row="3" VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI" Margin="0,0,0,8"/>
            <TextBox x:Name="txtDescripcion" Grid.Row="3" Grid.Column="1" Style="{StaticResource Win10TextBox}" IsEnabled="False" Margin="0,0,0,8"/>

            <TextBlock Text="Precio:" Grid.Row="4" VerticalAlignment="Center" FontSize="13" FontFamily="Segoe UI" Margin="0,0,0,8"/>
            <TextBox x:Name="txtPrecio" Grid.Row="4" Grid.Column="1" Style="{StaticResource Win10TextBox}" IsEnabled="False" Margin="0,0,0,8"/>
        </Grid>

        <Button Grid.Row="3" x:Name="btnSalir" Content="Salir" Width="80" Height="28" HorizontalAlignment="Right" Background="#E1E1E1" Foreground="#0078D7" BorderBrush="#7A7A7A" BorderThickness="1" Cursor="Hand" Template="{StaticResource PlantillaBotonAzul}" Click="btnSalir_Click"/>
    </Grid>
</Window>
